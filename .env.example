# ── Hostinger (Node web app) environment ─────────────────────
# Copy these names into hPanel → Websites → your app → Environment variables.
# Never commit the real values.

# MySQL database from hPanel → Databases → MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_nmfinance
DB_USER=u123456789_admin
DB_PASSWORD=

# Long random string (32+ characters). Changing it signs everybody out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First sign-in, created automatically only while no users exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional
# ADMIN_EMAILS=you@example.com,partner@example.com   (extra admin rights)
# AUTO_MIGRATE=0                                     (skip schema check on boot)
# COOKIE_SECURE=1                                    (force Secure cookies)
