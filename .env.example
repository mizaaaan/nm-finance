# Environment variables for Next Millionaire Finance.
#
# These are set in the Netlify dashboard (Site configuration → Environment
# variables), NOT committed to git. For local work copy this file to .env
# (it is git-ignored) or use `netlify dev`, which loads the site's variables.

# ── Required ────────────────────────────────────────────────────────────

# Who may ADD / EDIT / DELETE. Comma-separated emails of the people running the
# books. Without this (and without giving someone the Netlify Identity "admin"
# role) nobody can write.
# Emails are trusted only because Netlify Identity confirms them — keep
# "email confirmation" switched ON in Identity settings.
ADMIN_EMAILS=owner@example.com

# ── Optional ────────────────────────────────────────────────────────────

# Who may only VIEW. Comma-separated emails. (Or give people the Netlify
# Identity role "member".) A signed-in account that is neither an admin nor a
# member sees a "waiting for approval" screen and no data.
MEMBER_EMAILS=

# true = every signed-in account may VIEW (the old behaviour). Only sensible if
# Identity registration is set to "Invite only". Leave unset otherwise.
ALLOW_ANY_SIGNED_IN_USER=

# true = show the "Reset company data" button, which permanently deletes all
# members, cars and transactions. Leave unset on a live system.
ENABLE_DATA_RESET=

# ── Provided by Netlify (do not set on the live site) ───────────────────────

# Postgres connection string. Netlify DB injects NETLIFY_DB_URL automatically.
# For local development or tests against another Postgres, use DATABASE_URL.
# NETLIFY_DB_URL=
# DATABASE_URL=postgres://user:password@localhost:5432/nm_finance

# TLS to the database is required by default. Set to false ONLY for a local
# Postgres without TLS.
# DATABASE_SSL=false

# Identity JWT secret. Optional: when absent the API asks Netlify Identity to
# validate each token instead (a little slower, equally secure).
# JWT_SECRET=
